---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Our Services | CodeCraft Nepal',
};
---

<Layout metadata={metadata}>

  <!-- Hero -->

  <Hero
    tagline="CODECRAFT NEPAL"
    title="Professional IT Services for Modern Businesses"
    subtitle="We help startups, schools, businesses and organizations build secure, scalable and modern digital solutions with the latest technologies."
    actions={[
      {
        variant: 'primary',
        text: 'Request Free Consultation',
        href: '/contact',
      },
      {
        text: 'Contact Us',
        href: '/contact',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=1600&q=80',
      alt: 'CodeCraft Nepal Services',
    }}
  />



  <!-- Services -->

  <Features2
    title="Our Professional Services"
    subtitle="Complete IT Solutions for Individuals, Businesses, Schools and Organizations."
    columns={3}

    items={[

      {
        title: 'Website Development',
        description:
          'Business Websites, School Websites, E-Commerce, Portfolio, Landing Pages and Custom Web Applications.',
        icon: 'tabler:world-www',
      },

      {
        title: 'Software Development',
        description:
          'ERP Systems, Billing Software, School Management Systems and Custom Desktop Applications.',
        icon: 'tabler:device-desktop-code',
      },

      {
        title: 'Mobile App Development',
        description:
          'Professional Android & iOS Applications with modern UI and powerful performance.',
        icon: 'tabler:device-mobile-code',
      },

      {
        title: 'Cloud Hosting',
        description:
          'VPS Hosting, Dedicated Servers, Cloud Infrastructure and Email Hosting Solutions.',
        icon: 'tabler:server',
      },

      {
        title: 'Cyber Security',
        description:
          'Website Security, Server Hardening, Malware Removal and Security Consultation.',
        icon: 'tabler:shield-lock',
      },

      {
        title: 'Graphics & Branding',
        description:
          'Professional Logo Design, Brand Identity, Posters, Banners and Marketing Graphics.',
        icon: 'tabler:palette',
      },

      {
        title: 'SEO & Digital Marketing',
        description:
          'Google SEO, Facebook Ads, Google Ads and Complete Digital Marketing Solutions.',
        icon: 'tabler:search',

      },

      {
        title: 'Domain & Email',
        description:
          'Domain Registration, Business Email, DNS Management and SSL Installation.',
        icon: 'tabler:world',

      },

      {
        title: 'Technical Support',
        description:
          '24×7 Technical Support, Server Maintenance and Complete IT Consultancy.',
        icon: 'tabler:headset',

      },

    ]}

  />
</Layout>
