---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Contact from '~/components/widgets/Contact.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>

  <Hero
    tagline="CONTACT US"
    title="Let's Build Something Amazing Together"
    subtitle="Have a project in mind? Contact CodeCraft Nepal today for professional IT solutions."
    actions={[
      {
        variant: 'primary',
        text: 'Call Now',
        href: 'tel:+9779807618948',
      },
      {
        text: 'WhatsApp',
        href: 'https://wa.me/9779807618948',
      },
    ]}
  />
<section class="max-w-4xl mx-auto px-6 py-16">
  <div class="rounded-xl border border-gray-200 dark:border-gray-700 p-8 bg-white dark:bg-slate-900 shadow">

    <h2 class="text-3xl font-bold mb-8">Contact Information</h2>

    <div class="space-y-6 text-lg">

      <div>
        <strong>📍 Office</strong><br />
        Bhramarpura Chowk Janakpurdham, Nepal
      </div>

      <div>
        <strong>📞 Phone</strong><br />
        <a href="tel:+9779807618948" class="text-blue-600">
          +977 9807618948
        </a>
      </div>

      <div>
        <strong>💬 WhatsApp</strong><br />
        <a href="https://wa.me/9779807618948" class="text-green-600" target="_blank">
          +977 9807618948
        </a>
      </div>

      <div>
        <strong>🕒 Working Hours</strong><br />
        Sunday – Friday | 9:00 AM – 6:00 PM
      </div>

    </div>

  </div>
</section>
  <Contact
    tagline="GET IN TOUCH"
        

</Layout>