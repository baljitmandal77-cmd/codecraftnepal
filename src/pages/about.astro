---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'About Us',
};
---

<Layout metadata={metadata}>

  <Hero
    tagline="ABOUT CODECRAFT NEPAL"
    title="Building Modern Digital Solutions for Nepal"
    subtitle="CodeCraft Nepal is a professional IT company providing complete technology solutions for startups, schools, businesses and organizations."
    actions={[
      {
        variant: 'primary',
        text: 'Contact Us',
        href: '/contact',
      },
      {
        text: 'Our Services',
        href: '/services',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=1600&q=80',
      alt: 'CodeCraft Nepal Team',
    }}
  />



  <Content
    items={[
      {
        title: 'Who We Are',
        description:
          'We are a passionate team of developers, designers and IT professionals committed to delivering high-quality digital solutions.',
      },
      {
        title: 'Our Mission',
        description:
          'To empower businesses with modern, secure and scalable technology solutions at affordable prices.',
      },
      {
        title: 'Our Vision',
        description:
          'To become one of Nepal’s most trusted and innovative IT companies.',
      },
      {
        title: 'Our Values',
        description:
          'Innovation, Quality, Transparency, Customer Satisfaction and Long-term Relationships.',
      },
    ]}
    image={{
      src:'https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1200&q=80',
      alt:'Our Company',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">
        About CodeCraft Nepal
      </h3>

      <p>
        CodeCraft Nepal delivers complete IT solutions including
        Website Development, Software Development,
        Mobile App Development, Cyber Security,
        Cloud Hosting, Domain Registration,
        Graphics Design, Digital Marketing
        and Technical Support.
      </p>
    </Fragment>
  </Content>



  <Stats
    stats={[
      { title: 'Projects Completed', amount: '100+' },
      { title: 'Happy Clients', amount: '50+' },
      { title: 'IT Services', amount: '15+' },
      { title: 'Support', amount: '24/7' },
    ]}
  />



  <CallToAction
    title="Let's Build Something Amazing Together"
    subtitle="Need a website, software or mobile app? Contact CodeCraft Nepal today."
    actions={[
      {
        variant:'primary',
        text:'Get Free Consultation',
        href:'/contact',
      },
    ]}
  />

</Layout>