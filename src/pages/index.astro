---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'CodeCraft Nepal | Professional IT Company in Nepal',
  description:
    'Website Development, Software Development, Mobile App Development, Cyber Security, Cloud Hosting, Digital Marketing and IT Solutions.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
  actions={[
    {
      variant: 'primary',
      text: 'Get Free Consultation',
      href: '/contact',
    },
    {
      text: 'Our Services',
      href: '/services',
    },
  ]}
  image={{
    src: '~/assets/images/hero-image.png',
    alt: 'CodeCraft Nepal'
  }}
>
  <Fragment slot="title">
    Complete <span class="text-accent">IT Solutions</span><br />
    For Your Business
  </Fragment>

  <Fragment slot="subtitle">
    CodeCraft Nepal provides professional Website Development,
    Software Development, Mobile App Development, Cyber Security,
    Cloud Hosting, Graphics Design, Domain Registration,
    Digital Marketing and Technical Support across Nepal.
  </Fragment>
</Hero>

  <!-- Note Widget ******************* -->

<Note
  title="Why CodeCraft Nepal?"
  description="Reliable • Secure • Modern • Scalable IT Solutions"
/>
  <!-- Features Widget *************** -->

  <Features
  id="services"
  tagline="OUR SERVICES"
  title="Complete IT Solutions Under One Roof"

  subtitle="We build secure, scalable and modern digital solutions for startups, schools, businesses and organizations."

  items={[
    {
      title: 'Website Development',
      description:
        'Business Website, E-Commerce, School Website, Portfolio, News Portal and Custom Web Applications.',
      icon: 'tabler:world-www',
    },

    {
      title: 'Software Development',
      description:
        'Desktop Software, ERP Systems, School Management, Billing and Custom Business Solutions.',
      icon: 'tabler:device-desktop',
    },

    {
      title: 'Mobile App Development',
      description:
        'Android & iOS Applications with modern UI and high performance.',
      icon: 'tabler:device-mobile',
    },

    {
      title: 'Cyber Security',
      description:
        'Security Audits, Website Protection, Server Hardening and Technical Support.',
      icon: 'tabler:shield-lock',
    },

    {
      title: 'Cloud Hosting & Domains',
      description:
        'VPS Hosting, Cloud Infrastructure, Domain Registration and Email Hosting.',
      icon: 'tabler:server',
    },

    {
      title: 'Digital Marketing',
      description:
        'SEO, Google Ads, Facebook Marketing, Branding and Graphics Design.',
      icon: 'tabler:chart-line',
    },
  ]}
/>

  <!-- Content Widget **************** -->

  <Content
tagline="WHY CHOOSE US"
title="Modern Technology. Real Business Results."

items={[
{
title:"Experienced Team",
description:"Professional developers and IT experts."
},
{
title:"Affordable Pricing",
description:"Best quality with reasonable pricing."
},
{
title:"Fast Delivery",
description:"On-time project completion."
},
]}
image={{
src:"https://images.unsplash.com/photo-1498050108023-c5249f4df085",
alt:"Team"
}}
>
<Fragment slot="content">

We build modern websites, software, mobile apps and cloud infrastructure for businesses across Nepal.

</Fragment>
</Content>

  <!-- Content Widget **************** -->

  <Content
isAfterContent
items={[
{
title:"Website Design",
description:"Responsive business websites."
},
{
title:"ERP Solutions",
description:"School, College and Business ERP."
},
{
title:"Hosting",
description:"Cloud VPS and Dedicated Hosting."
},
{
title:"Support",
description:"24/7 Technical Assistance."
},
]}
image={{
src:"https://images.unsplash.com/photo-1516321318423-f06f85e504b3",
alt:"Office"
}}
>
<Fragment slot="content">

Everything you need under one roof.

</Fragment>
</Content>

  <!-- Content Widget **************** -->

  <Content
isReversed
isAfterContent
items={[
{
title:"Cyber Security",
description:"Protect your business."
},
{
title:"SEO",
description:"Rank higher on Google."
},
{
title:"Brand Identity",
description:"Professional logos and graphics."
},
{
title:"Cloud Infrastructure",
description:"Scalable VPS solutions."
},
]}
image={{
src:"https://images.unsplash.com/photo-1550751827-4bd374c3f58b",
alt:"Security"
}}
>
<Fragment slot="content">

Helping businesses grow with secure technology.

</Fragment>
</Content>

  <!-- Steps Widget ****************** -->


<Steps
  title="How We Turn Your Idea Into Reality"
  items={[
    {
      title: 'Step 1: <span class="font-medium">Consultation</span>',
      description:
        'Share your business idea or project requirements with our team. We understand your goals and suggest the best technology solution.',
      icon: 'tabler:messages',
    },
    {
      title: 'Step 2: <span class="font-medium">Design & Development</span>',
      description:
        'Our designers and developers build a secure, responsive and modern website, software or mobile application tailored to your needs.',
      icon: 'tabler:code',
    },
    {
      title: 'Step 3: <span class="font-medium">Testing & Launch</span>',
      description:
        'Every project is thoroughly tested before deployment. After launch, we provide ongoing maintenance and technical support.',
      icon: 'tabler:rocket',
    },
    {
      title: 'Project Delivered Successfully',
      icon: 'tabler:check',
    },
  ]}
  image={{
    src: 'https://images.unsplash.com/photo-1552664730-d307ca884978',
    alt: 'CodeCraft Nepal Development Process',
  }}
/>

  <!-- Features2 Widget ************** -->

  <!-- Features2 Widget ************** -->

<Features2
  title="Why Businesses Choose CodeCraft Nepal"
  subtitle="Professional IT services designed to help your business grow faster."
  tagline="WHY CHOOSE US"

  items={[
    {
  title: 'Professional Team',
  description: 'Experienced developers, designers and IT professionals.',
  icon: 'tabler:users',
},
{
  title: 'Modern Technologies',
  description: 'Latest web, cloud and mobile development technologies.',
  icon: 'tabler:cpu',
},
{
  title: 'Fast Delivery',
  description: 'Projects delivered on schedule without compromising quality.',
  icon: 'tabler:clock-hour-4',
},
{
  title: 'Cyber Security',
  description: 'Secure infrastructure and protection for your business.',
  icon: 'tabler:shield-lock',
},
{
  title: 'Cloud Hosting',
  description: 'Reliable VPS, Dedicated Servers and Cloud Solutions.',
  icon: 'tabler:cloud-computing',
},
{
  title: 'SEO Friendly',
  description: 'Optimized websites that perform well on Google Search.',
  icon: 'tabler:search',
},
{
  title: '24/7 Technical Support',
  description: 'Quick support whenever your business needs assistance.',
  icon: 'tabler:headset',
},
{
  title: 'Affordable Pricing',
  description: 'Quality IT services at competitive prices.',
  icon: 'tabler:currency-dollar',
},
{
  title: 'Long Term Partnership',
  description: 'We grow together with our clients through continuous support.',
  icon: 'tabler:plug-connected',
},
  ]}
>
  <Fragment slot="bg">
    <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
  </Fragment>
</Features2>

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="Find out more content in our Blog"
    information={`The blog is used to display AstroWind documentation.
                        Each new article will be an important step that you will need to know to be an expert in creating a website using Astro v6 + Tailwind CSS v4.
                        Astro is a very interesting technology. Thanks.
                `}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Users', amount: '5.2K' },
      { title: 'Business', amount: '11' },
      { title: 'Clients', amount: '27' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'View Demo',
        href: 'https://alhebs.baljitmandal.com.np/',
        target: '_blank',
        icon: 'tabler:picture-in-picture',
      },
    ]}
  >
    <Fragment slot="title">
      
      Transforming The World&nbsp;&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">into Digital</span>
    </Fragment>

    <Fragment slot="subtitle">
       <br class="hidden md:inline" />Don't
      waste more time!
    </Fragment>
  </CallToAction>
</Layout>
